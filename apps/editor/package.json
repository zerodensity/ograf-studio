{
  "name": "editor",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "predev": "bun run ../../scripts/buildBundledStudioPlugins.mjs",
    "prebuild": "node ../../scripts/packageAuthoringSkill.mjs && node ../../scripts/generateStudioRuntimeLicense.mjs && bun run ../../scripts/buildBundledStudioPlugins.mjs",
    "prebuild:standalone": "node ../../scripts/packageAuthoringSkill.mjs && node ../../scripts/generateStudioRuntimeLicense.mjs && bun run ../../scripts/buildBundledStudioPlugins.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "@ograf-editor/agent-tools": "*",
    "@ograf-editor/codegen": "*",
    "@ograf-editor/ograf-runtime": "*",
    "@ograf-editor/ograf-types": "*",
    "@ograf-editor/scene-model": "*",
    "@ograf-editor/ui-kit": "*",
    "@ograf-editor/validation": "*",
    "ag-psd": "^34.1.0",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.16",
    "jszip": "^3.10.2",
    "paper": "^0.12.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-moveable": "^0.56.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
